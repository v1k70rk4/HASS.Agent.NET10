<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Packages come from nuget.org and from nowhere else: a source set up on the PC or for the
       user (clear), or one added here later, is not asked for any of them (the mapping). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
