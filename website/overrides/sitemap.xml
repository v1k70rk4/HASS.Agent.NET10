{#- MkDocs' own sitemap, plus the hreflang links: the home page and the language pages (docs/hu/ and so on)
    are the same page in different languages, and a search engine that is told so shows each reader the one
    in their language. They are here and not in the pages' <head>, where the theme's script would take them
    for whole translated sites (website/hooks.py). -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for file in pages -%}
    {% if not file.page.is_link and (file.page.abs_url or file.page.canonical_url) %}
    <url>
         <loc>{% if file.page.canonical_url %}{{ file.page.canonical_url|e }}{% else %}{{ file.page.abs_url|e }}{% endif %}</loc>
         {% if file.page.update_date %}<lastmod>{{file.page.update_date}}</lastmod>{% endif %}
         {%- if file.page.is_homepage or file.page.meta.lang %}
         {%- for alt in config.extra.alternate %}
         <xhtml:link rel="alternate" hreflang="{{ alt.lang }}" href="{{ config.site_url.rstrip('/') }}{{ alt.link }}"/>
         {%- endfor %}
         <xhtml:link rel="alternate" hreflang="x-default" href="{{ config.site_url }}"/>
         {%- endif %}
    </url>
    {%- endif -%}
{% endfor %}
</urlset>
