<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HASS.Agent.NET10</AssemblyName>
    <RootNamespace>HASS.Agent.Companion</RootNamespace>
    <ApplicationIcon>Assets\hassagent.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Version>10.13.0</Version>
    <Company>v1k70rk4</Company>
    <Authors>v1k70rk4</Authors>
    <Description>Modern .NET 10 Windows client for the HASS.Agent Home Assistant integration.</Description>
    <Copyright>MIT</Copyright>
    <!-- The frameworks are the ones named here (WinForms, ASP.NET Core), not the ones a package
         asks for. System.Reactive (under Sendspin.SDK, through Zeroconf) asks for WPF in its
         Windows build, and a self-contained publish then carried all of WPF: 58 MB of an exe
         that uses none of it. Nothing here reaches a WPF type of Rx (its dispatcher scheduler). -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <!-- The packages a build takes are the ones written down in packages.lock.json, each with
         its hash. In CI and in a release build (build-exe.ps1 -Tag) a restore that would take
         anything else fails instead of going on. win-x64 is named so that the lock file covers
         the publish too. After a change of a package or of the SDK in global.json, write the
         lock files again: dotnet restore src/HASS.Agent.sln with the force-evaluate switch. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The single-file publish turns this analyzer on, and it comes as a package of the SDK
         (Microsoft.NET.ILLink.Tasks). On for every build, so that a build and a publish take
         the same packages and one lock file serves both. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project (tests/HASS.Agent.NET10.Tests) reaches the internal helpers. -->
    <InternalsVisibleTo Include="HASS.Agent.NET10.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\hassagent.ico" LogicalName="hassagent.ico" />
    <!-- The texts of the app, one file per language; Localization/Strings.cs finds them by name. -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- The Sendspin player (Media/Sendspin). Pinned: a major version of the SDK follows the
         protocol and has broken its API before, so it is taken up on purpose, not by a range. -->
    <PackageReference Include="Sendspin.SDK" Version="10.1.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF control as well; this is a WinForms app, and the
       WPF one drags in a WindowsBase version conflict (a warning, and warnings are errors here). -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- Signed builds (build-exe.ps1 -Sign, -Tag): the native libraries that come unsigned from their
       makers (libsodium, under the Sendspin player) are signed first and their folder is handed in
       as SignedNativeDir. The publish takes those copies instead of the package's: next to the exe in
       the release layout, and inside the single-file exe, which unpacks them at start. -->
  <Target Name="UseSignedNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(SignedNativeDir)' != ''">
    <ItemGroup>
      <_SignedNativeLibrary Include="@(ResolvedFileToPublish)" Condition="Exists('$(SignedNativeDir)\%(Filename)%(Extension)')" />
      <ResolvedFileToPublish Remove="@(_SignedNativeLibrary)" />
      <ResolvedFileToPublish Include="@(_SignedNativeLibrary->'$(SignedNativeDir)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <Message Importance="high" Text="Signed native library: %(_SignedNativeLibrary.Filename)%(_SignedNativeLibrary.Extension)" Condition="'@(_SignedNativeLibrary)' != ''" />
  </Target>

</Project>
